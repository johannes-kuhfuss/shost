{{ define "certificate.page.tmpl" }}

{{ template "header" .}}

    <div class="container-fluid py-5">
        <div class="row">
            <div class="col">
                <h3>TLS Certificate</h3>
                {{ if .error }}
                <div class="alert alert-info" role="status">{{ .error }}</div>
                {{ else }}
                <p>Currently loaded certificate. Dates are shown in UTC. Refresh to see the latest values.</p>
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th scope="col">Property</th>
                                <th scope="col">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><th scope="row">Subject</th><td>{{ .certificate.Subject }}</td></tr>
                            <tr><th scope="row">Issuer</th><td>{{ .certificate.Issuer }}</td></tr>
                            <tr><th scope="row">Serial Number</th><td class="text-break">{{ .certificate.SerialNumber }}</td></tr>
                            <tr>
                                <th scope="row">DNS Names</th>
                                <td>{{ range .certificate.DNSNames }}<div class="text-break">{{ . }}</div>{{ else }}N/A{{ end }}</td>
                            </tr>
                            <tr><th scope="row">Valid From (UTC)</th><td>{{ .notBefore }}</td></tr>
                            <tr><th scope="row">Expires At (UTC)</th><td>{{ .notAfter }}</td></tr>
                            <tr><th scope="row">Last Renewed (UTC)</th><td>{{ .lastRenewed }}</td></tr>
                            <tr><th scope="row">SHA-256 Fingerprint</th><td class="text-break"><code>{{ .certificate.SHA256Fingerprint }}</code></td></tr>
                        </tbody>
                    </table>
                </div>
                {{ end }}
            </div>
        </div>
    </div>

{{ template "footer" .}}

{{ end }}
