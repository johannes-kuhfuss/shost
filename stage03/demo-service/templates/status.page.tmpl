{{ define "status.page.tmpl" }}

{{ template "header" .}}

   <div class="container-fluid py-5">
        <div class="row">
            <div class="col">
                <h3>Configuration and Runtime</h3>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                          <th scope="col" style="width: 35%">Variable</th>
                          <th scope="col" style="width: 65%">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                          <td>Pod Name</td>
                          <td>{{ or .configdata.PodName "N/A" }}</td>
                        </tr>
                        <tr>
                          <td>Pod IP</td>
                          <td>{{ or .configdata.PodIP "N/A" }}</td>
                        </tr>
                        <tr>
                          <td>Pod Namespace</td>
                          <td>{{ or .configdata.PodNamespace "N/A" }}</td>
                        </tr>
                        <tr>
                          <td>Node Name</td>
                          <td>{{ or .configdata.NodeName "N/A" }}</td>
                        </tr>
                        <tr>
                          <td>Server listening on</td>
                          <td>{{ .configdata.ListeningAddr }}</td>
                        </tr>
                        <tr>
                          <td>Configured TLS Port</td>
                          <td>{{ .configdata.TlsPort }}</td>
                        </tr>
                        <tr>
                          <td>Configured Shutdown Time</td>
                          <td>{{ .configdata.GracefulShutdownTime }}</td>
                        </tr>
                        <tr>
                          <td>Configured Pod Drain Time</td>
                          <td>{{ .configdata.DrainRequestTime }}</td>
                        </tr>
                        <tr>
                          <td>Configured to use TLS</td>
                          <td>{{ .configdata.UseTls }}</td>
                        </tr>
                        <tr>
                          <td>Certificate File</td>
                          <td>{{ .configdata.CertFile }}</td>
                        </tr>
                        <tr>
                          <td>Key File</td>
                          <td>{{ .configdata.KeyFile }}</td>
                        </tr>
                        <tr>
                          <td>Service Start Date</td>
                          <td>{{ .configdata.ServiceStartDate }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{{ template "footer" .}}

{{ end }}
