{{ define "probes.page.tmpl" }}

{{ template "header" .}}

    <div class="container-fluid py-5">
        <div class="row">
            <div class="col">
                <h3>Probe Status</h3>
                <p>Probe requests since the service started. Dates are shown in UTC. Refresh to see the latest values.</p>
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th scope="col">Probe</th>
                                <th scope="col">Last Probe Date (UTC)</th>
                                <th scope="col">Probe Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range .probes }}
                            <tr>
                                <th scope="row">{{ .Name }}</th>
                                <td>{{ .LastProbeDate }}</td>
                                <td>{{ .Count }}</td>
                            </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{{ template "footer" .}}

{{ end }}
