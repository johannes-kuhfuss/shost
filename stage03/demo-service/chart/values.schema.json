{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicaCount",
    "resources",
    "logging",
    "shutdown",
    "clusterDomain",
    "hostname",
    "gateway",
    "certificate",
    "trustBundleName"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "level"
      ],
      "properties": {
        "format": {
          "enum": [
            "text",
            "json"
          ]
        },
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drainSeconds",
        "timeoutSeconds",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "drainSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "sectionName"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "sectionName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "renewBefore",
        "issuerRef"
      ],
      "properties": {
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "renewBefore": {
          "type": "string",
          "minLength": 1
        },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "trustBundleName": {
      "type": "string",
      "minLength": 1
    }
  }
}
